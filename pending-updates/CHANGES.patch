+    normalizedUnit.includes(u)
+  );
+  const pct = higherIsBetter
+    ? ((currentValue - previousValue) / previousValue) * 100
+    : ((previousValue - currentValue) / previousValue) * 100;
+  return Number(pct.toFixed(1));
+}
 
