# =============================================================================
# CAPTENLY — Authentication Environment Variables (Auth.js v5 + Google OAuth)
# انسخ هذا الملف إلى .env.local ثم أضف قيم مشروعك من Google Cloud Console
# =============================================================================

# 1) سر تشفير الجلسات (مطلوب لـ Auth.js v5)
# يمكن توليده عبر الأمر: npx auth secret أو openssl rand -base64 32
AUTH_SECRET=

# 2) رابط التطبيق (في التطوير المحلي اتركه http://localhost:3000)
AUTH_URL=http://localhost:3000

# 3) بيانات تطبيق Google OAuth من Google Cloud Console:
# APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4) مفتاح خرائط جوجل (اختياري - للتحويل للخريطة التفاعلية متعددة الدبابيس والبحث التلقائي Places)
# بدون هذا المفتاح تعمل خرائط Google المدمجة + حساب المسافات + روابط الاتجاهات تلقائياً
# للحصول عليه: Google Cloud Console -> APIs & Services -> Enable (Maps JavaScript API + Places API) -> Create API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_SERVER_API_KEY=

# 5) قاعدة بيانات Supabase (يحقنها Vercel Marketplace تلقائياً عند ربط Integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
